	procedure run is
		l_result number;
		cursor c_values is select level as value from dual connect by level <= 10;
	begin
		for r in c_values loop
			l_result := routine_0(r.value);
		end loop;

		begin
			l_result := l_result + 1;
		exception
			when others then
				l_result := 0;
		end;

		if l_result is not null then
			dbms_output.put_line(to_char(l_result));
		end if;
	end run;
end synthetic_6;
